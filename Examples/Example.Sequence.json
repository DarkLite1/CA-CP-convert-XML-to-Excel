{
  "Type": "Sequence",
  "MaxConcurrentJobs": {
    "GetXmlFileDates": 5,
    "CreateExcelFile": 1
  },
  "SendMail": {
    "To": ["bob@contoso.com"],
    "When": "Always"
  },
  "ExcelFileName": "Sequences - {0} - XML Files summary.xlsx",
  "Path": {
    "XmlFiles": "C:\\XML Files folder\\Sequence",
    "ExcelFiles": "C:\\Excel Files folder\\Sequence"
  },
  "?": {
    "Type": "Batch | Alarm | Sequence",
    "SendMail.When": "Never | OnlyOnError | OnlyOnErrorOrAction | Always"
  }
}
